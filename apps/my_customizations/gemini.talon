tag: browser
browser.host: gemini.google.com
-
chat new: key(ctrl-shift-o)

[message] send: key(enter)
[insert] new line: key(shift-enter)
(stop | stop generating): key(escape)

focus input: key(ctrl-/)
(sidebar | menu) toggle: key(ctrl-shift-s)
search: key(ctrl-shift-f)
(settings open | open settings): key(ctrl-,)

response copy: key(ctrl-shift-c)

(convo | chat) next: key(alt-down)
(convo | chat) last: key(alt-up)
