list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

#round: ( )
#box: [ ]
#diamond: < >
curly: { }
#twin: "' '"
#quad: '" "'
#skis: ` `
#percentages: % %
pad: space space

#escaped round: \( \)
#escaped box: \[ \]
#escaped quad: '\\" \\"'
#escaped twin: "\\' \\'"

# My customizations 
paren: ( )
#square: [ ]
bracket: [ ]
#square bracket: [ ]
#brace: { }
angle: < >
apostrophe: "' '"
quote: "' '"
#string: "' '"
#double quote: '" "'
dub quote: '" "'
grave: ` `
#back tick: ` `
percent: % %