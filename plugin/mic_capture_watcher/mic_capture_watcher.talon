os: windows
-
# The watcher auto-starts based on the user.mic_capture_watch_enabled
# setting (default: True). To turn it off, add this to settings.talon:
#
#     settings():
#         user.mic_capture_watch_enabled = 0
#
# The voice commands below are kept for debugging. Uncomment if needed.
#
# mic watch start: user.mic_capture_start_watch()
# mic watch stop: user.mic_capture_stop_watch()
# mic check now: user.mic_capture_check_now()
# mic dump sessions: user.mic_capture_dump_sessions()
# mic reset: user.mic_capture_reset()
