os: windows
-
# The watcher auto-starts based on the user.windows_dictation_watch_enabled
# setting (default: True). To turn it off, add this to settings.talon:
#
#     settings():
#         user.windows_dictation_watch_enabled = 0
#
# The voice commands below are kept for debugging. Uncomment if needed.
#
# dictation watch start: user.windows_dictation_start_watch()
# dictation watch stop: user.windows_dictation_stop_watch()
# dictation check now: user.windows_dictation_check_now()
# dictation dump sessions: user.windows_dictation_dump_sessions()
